# Путь к файлу SQLite
DATABASE_PATH=data/metacritic.db

# Обход: сколько игр загружать за один запуск (новые и повторные визиты вместе)
CRAWL_BUDGET=250

# Анализ отзывов: сколько игр обрабатывать за один запуск
ANALYSIS_BUDGET=40

# Сколько самых новых игр просматривать в списках в поисках новых
DISCOVERY_DEPTH=250

# Игра считается молодой столько дней после того, как мы её нашли; молодые обновляются раз в REVISIT_YOUNG_HOURS часов, остальные раз в REVISIT_OLD_DAYS дней
YOUNG_DAYS=30
REVISIT_YOUNG_HOURS=24
REVISIT_OLD_DAYS=7

# Как часто запускается обход, часы
CRAWL_INTERVAL_HOURS=1

# Как часто запускается анализ отзывов, часы, и на сколько минут позже обхода он стартует
ANALYSIS_INTERVAL_HOURS=1
ANALYSIS_OFFSET_MINUTES=30

# Запускать обход сразу при старте приложения (анализ стартует позже на ANALYSIS_OFFSET_MINUTES)
SYNC_RUN_ON_STARTUP=true

# Пауза между запросами к Metacritic, секунды
REQUEST_DELAY_SECONDS=1.0

# Таймаут запроса, секунды
REQUEST_TIMEOUT_SECONDS=30

# Количество повторов при сбое запроса
REQUEST_RETRIES=3

# Резюме отзывов через LLM (OpenAI-совместимый API). Без ключа резюме не строятся
LLM_API_KEY=
LLM_BASE_URL=https://ai.starimg.ru
LLM_MODEL=claude-haiku-5-5

# Не пересчитывать резюме чаще, чем раз в N часов
SUMMARY_MIN_INTERVAL_HOURS=24

# Размер выборки отзывов для резюме и длина текста одного отзыва
CRITICS_SAMPLE_LIMIT=30
USERS_SAMPLE_LIMIT=40
REVIEW_TEXT_LIMIT=600

# Поиск видео на YouTube (YouTube Data API v3, квота 10000 единиц в сутки). Без ключа поиск выключен
YOUTUBE_API_KEY=

# Поиск видео: сколько игр обрабатывать за запуск, как часто запускать и на сколько минут позже обхода стартовать
VIDEOS_BUDGET=4
VIDEOS_INTERVAL_HOURS=1
VIDEOS_OFFSET_MINUTES=45

# Через сколько дней искать видео молодой игры снова: найденное видео / ничего не найдено
VIDEOS_REFRESH_DAYS=14
VIDEOS_RETRY_DAYS=3
